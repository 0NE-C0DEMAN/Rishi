# Copy this file to `.streamlit/secrets.toml` (which is gitignored) and fill in
# real values. On Streamlit Community Cloud, paste the same keys into
# App settings -> Secrets instead of committing the file.

# Put the access gate in front of the console. Defaults to false, which is
# right locally and WRONG for a public URL — set it to true before deploying,
# or anyone with the link can open the app.
require_login = true

# Access key for the console login gate. Change it from the placeholder.
app_password = "change-me-before-deploy"

# Google Gemini API key (Google AI Studio). Powers the live Gemma 4 executive
# narrative. Leave blank to disable the live call — the built-in local
# synthesis still works and is labelled as such in the interface.
gemini_api_key = ""
